---
import type { PasskeyRow } from "../lib/passkeys.ts";

// Adding and removing a passkey, for the signed-in member only. With scripts
// off it says what a passkey needs; the device-cookie flow still works.
interface Props {
  passkeys: PasskeyRow[];
}
const { passkeys } = Astro.props;
const day = (at: number) => new Date(at).toISOString().slice(0, 10);
---

<div class="stack" id="passkey-register">
  <p class="muted">A passkey signs you back in on a device with no cookie, without a name or link. It stays on your device.</p>
  <noscript><p class="muted">Passkeys need scripts. Add a device by link or QR code instead.</p></noscript>
  {
    passkeys.length > 0 && (
      <ul class="rows" aria-label="Your passkeys">
        {passkeys.map((p) => (
          <li>
            <span class="who">Added {day(p.createdAt)}{p.lastUsedAt ? `, last used ${day(p.lastUsedAt)}` : ", not used yet"}</span>
            <form method="post" action={`/passkey/${p.id}/remove`}>
              <button type="submit" aria-label="Remove passkey">Remove</button>
            </form>
          </li>
        ))}
      </ul>
    )
  }
  <p>
    <button type="button" id="passkey-add" hidden>Add a passkey</button>
  </p>
  <p id="passkey-unsupported" hidden>This browser can't use passkeys.</p>
  <p id="passkey-status" role="status"></p>
</div>

<script>
  import { browserSupportsWebAuthn, startRegistration } from "@simplewebauthn/browser";

  const button = document.getElementById("passkey-add") as HTMLButtonElement | null;
  const unsupported = document.getElementById("passkey-unsupported");
  const status = document.getElementById("passkey-status");

  if (button && unsupported && status) {
    if (browserSupportsWebAuthn()) {
      button.hidden = false;
      button.addEventListener("click", async () => {
        status.textContent = "";
        button.disabled = true;
        try {
          const options = await fetch("/passkey/register/options", { method: "POST" });
          if (!options.ok) throw new Error("options");
          const response = await startRegistration({ optionsJSON: await options.json() });
          const verified = await fetch("/passkey/register/verify", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(response),
          });
          if (!verified.ok) throw new Error("verify");
          location.reload();
        } catch {
          status.textContent = "That passkey couldn't be added. Try again.";
          button.disabled = false;
        }
      });
    } else {
      unsupported.hidden = false;
    }
  }
</script>
