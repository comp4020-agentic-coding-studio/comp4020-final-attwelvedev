---
// A freshly minted link in a read-only field, so no-JS visitors can still
// copy it by hand, with a button that copies it for everyone else.
interface Props {
  id: string;
  value: string;
  label: string;
}
const { id, value, label } = Astro.props;
---

<div class="field">
  <label for={id}>{label}</label>
  <div class="link-field">
    <input id={id} readonly value={value} />
    <button type="button" data-copy-from={id}>Copy link</button>
  </div>
  <p class="muted" data-copy-status role="status"></p>
</div>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-from]")) {
    const field = document.getElementById(button.dataset.copyFrom ?? "") as HTMLInputElement | null;
    const status = button.closest(".field")?.querySelector("[data-copy-status]");
    button.addEventListener("click", async () => {
      if (!field) return;
      try {
        await navigator.clipboard.writeText(field.value);
        if (status) status.textContent = "Copied.";
      } catch {
        // clipboard blocked: select the text so a manual copy is one keystroke
        field.select();
        if (status) status.textContent = "Press Ctrl+C (or ⌘C) to copy.";
      }
    });
  }
</script>
