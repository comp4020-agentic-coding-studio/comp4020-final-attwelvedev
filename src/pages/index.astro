---
import { PantryList } from "../components/PantryList.tsx";
import Base from "../layouts/Base.astro";
import { db } from "../lib/db.ts";
import { listHistory } from "../lib/items.ts";
import { snapshotFor } from "../lib/snapshot.ts";

const { session, firstRunError, addError } = Astro.locals;
if (firstRunError || addError) Astro.response.status = 400;

const snapshot = session ? snapshotFor(db, session) : null;
const undoId = Astro.url.searchParams.get("undo");
const undone =
  session && undoId
    ? listHistory(db, session.household.id).find((h) => h.id === undoId)
    : undefined;
---

{
  session ? (
    <Base title={session.household.name}>
      <h1>{session.household.name}</h1>

      {undone && (
        <form class="undo" method="post" action={`/history/${undone.id}/undo`} role="status">
          <span>{undone.itemName} marked {undone.outcome}.</span>
          <button type="submit">Undo</button>
        </form>
      )}

      {snapshot && <PantryList client:load initial={snapshot} addError={addError} />}
    </Base>
  ) : (
    <Base title="Start your pantry">
      <h1>Start your pantry</h1>
      <form method="post" action="/households">
        {firstRunError && <p role="alert">{firstRunError.message}</p>}
        <p>
          <label for="householdName">Household name</label><br />
          <input id="householdName" name="householdName" required maxlength="60" autocomplete="off" value={firstRunError?.householdName ?? ""} />
        </p>
        <p>
          <label for="memberName">Your name</label><br />
          <input id="memberName" name="memberName" required maxlength="60" autocomplete="name" value={firstRunError?.memberName ?? ""} />
        </p>
        <button type="submit">Start pantry</button>
      </form>
      <p>
        Joining someone's household? Open their invite link, or <a href="/join">enter an invite code</a>.
      </p>
    </Base>
  )
}
