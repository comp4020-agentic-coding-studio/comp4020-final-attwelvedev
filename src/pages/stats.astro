---
import Base from "../layouts/Base.astro";
import { sharedStats } from "../lib/stats.ts";

// Aggregate only, and public on purpose: counts, and the last 30 actions as an
// anonymous device code, an action name and a status. The script below redraws
// it from /stats.json; without scripts this first render stays.
Astro.response.headers.set("Cache-Control", "no-store");
const s = sharedStats().snapshot();
const time = (ts: string) => ts.slice(11, 19);
const ROLES = ["blind", "deaf", "mute"];
const ROLE_NAME: Record<string, string> = {
  blind: "Can't see",
  deaf: "Can't hear",
  mute: "Can't speak",
};
const FAMILIES = ["say", "sound", "show"];
const { game } = s;
---

<Base title="Activity">
  <h1>Activity</h1>
  <p>What people are doing in this app right now. Counts since the server started; no names or messages.</p>

  <h2>Right now</h2>
  <dl class="totals">
    <div><dt>Lobbies open</dt><dd id="lobbies">{game.lobbiesOpen}</dd></div>
    <div><dt>Games playing</dt><dd id="games">{game.gamesPlaying}</dd></div>
    <div><dt>Players connected</dt><dd id="players">{game.playersConnected}</dd></div>
    <div><dt>Server memory (MB)</dt><dd id="memory">{game.rssMb}</dd></div>
  </dl>

  <h2>Since the server started</h2>
  <dl class="totals">
    <div><dt>Requests</dt><dd id="requests">{s.requests}</dd></div>
    <div><dt>Errors</dt><dd id="errors">{s.errors}</dd></div>
    <div><dt>Devices in the last 5 minutes</dt><dd id="devices">{s.activeDevices}</dd></div>
  </dl>

  <h2>Game events</h2>
  <ul class="rows" id="events">
    {Object.entries(game.events).sort((a, b) => b[1] - a[1]).map(([event, n]) => <li><span>{event}</span> <strong>{n}</strong></li>)}
  </ul>

  <h2>Channels by role</h2>
  <table>
    <thead><tr><th scope="col">Role</th>{FAMILIES.map((f) => <th scope="col">{f}</th>)}</tr></thead>
    <tbody id="channels">
      {ROLES.map((role) => <tr><th scope="row">{ROLE_NAME[role]}</th>{FAMILIES.map((f) => <td>{game.channelsByRole[role]?.[f] ?? 0}</td>)}</tr>)}
    </tbody>
  </table>

  <h2>By action</h2>
  <ul class="rows" id="actions">
    {Object.entries(s.actions).sort((a, b) => b[1] - a[1]).map(([action, n]) => <li><span>{action}</span> <strong>{n}</strong></li>)}
  </ul>

  <h2>Latest</h2>
  <p id="empty" hidden={s.recent.length > 0}>Nothing yet.</p>
  <ol class="rows" id="recent" aria-live="off">
    {s.recent.map((r) => <li><time>{time(r.ts)}</time> <span>{r.who ?? "no device"}</span> <span>{r.action}</span> <span>{r.status}</span></li>)}
  </ol>
</Base>

<style>
  .totals {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    margin: 0 0 24px;
  }
  .totals dt {
    font-size: 0.875rem;
  }
  .totals dd {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 600;
  }
  table {
    border-collapse: collapse;
    margin: 0 0 24px;
  }
  th,
  td {
    padding: 4px 16px 4px 0;
    text-align: left;
  }
  #recent li > * {
    overflow-wrap: anywhere;
  }
</style>

<script is:inline>
  (function () {
    var text = function (id, value) {
      document.getElementById(id).textContent = String(value);
    };
    var row = function (parts) {
      var li = document.createElement("li");
      parts.forEach(function (part, i) {
        if (i) li.append(" ");
        var el = document.createElement(part.tag || "span");
        el.textContent = part.text;
        li.append(el);
      });
      return li;
    };
    var ROLES = [["blind", "Can't see"], ["deaf", "Can't hear"], ["mute", "Can't speak"]];
    var FAMILIES = ["say", "sound", "show"];
    function cell(tag, value, scope) {
      var el = document.createElement(tag);
      if (scope) el.scope = scope;
      el.textContent = String(value);
      return el;
    }
    function draw(s) {
      var g = s.game;
      text("lobbies", g.lobbiesOpen);
      text("games", g.gamesPlaying);
      text("players", g.playersConnected);
      text("memory", g.rssMb);
      var events = document.getElementById("events");
      events.replaceChildren.apply(
        events,
        Object.entries(g.events)
          .sort(function (a, b) { return b[1] - a[1]; })
          .map(function (e) { return row([{ text: e[0] }, { tag: "strong", text: e[1] }]); }),
      );
      var channels = document.getElementById("channels");
      channels.replaceChildren.apply(
        channels,
        ROLES.map(function (r) {
          var tr = document.createElement("tr");
          tr.append(cell("th", r[1], "row"));
          FAMILIES.forEach(function (f) {
            tr.append(cell("td", (g.channelsByRole[r[0]] || {})[f] || 0));
          });
          return tr;
        }),
      );
      text("requests", s.requests);
      text("errors", s.errors);
      text("devices", s.activeDevices);
      var actions = document.getElementById("actions");
      actions.replaceChildren.apply(
        actions,
        Object.entries(s.actions)
          .sort(function (a, b) { return b[1] - a[1]; })
          .map(function (e) { return row([{ text: e[0] }, { tag: "strong", text: e[1] }]); }),
      );
      var recent = document.getElementById("recent");
      recent.replaceChildren.apply(
        recent,
        s.recent.map(function (r) {
          return row([
            { tag: "time", text: r.ts.slice(11, 19) },
            { text: r.who || "no device" },
            { text: r.action },
            { text: r.status },
          ]);
        }),
      );
      document.getElementById("empty").hidden = s.recent.length > 0;
    }
    function poll() {
      fetch("/stats.json", { cache: "no-store" })
        .then(function (res) { return res.json(); })
        .then(draw)
        .catch(function () {});
    }
    setInterval(poll, 2000);
  })();
</script>
