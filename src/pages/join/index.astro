---
import Base from "../../layouts/Base.astro";

const { session, joinError } = Astro.locals;
if (joinError) {
  Astro.response.status = joinError.status;
  if (joinError.status === 429) Astro.response.headers.set("Retry-After", "60");
}
---

<Base title="Join a household">
  <h1>Join a household</h1>
  {
    session ? (
      <p>You're already in {session.household.name}. A device is part of one household at a time.</p>
    ) : (
      <form class="stack" method="post" action="/join/code">
        {joinError && <p role="alert">{joinError.message}</p>}
        <p class="muted">Ask someone in the household for their invite code, like KETTLE-42.</p>
        <div class="field">
          <label for="code">Invite code</label>
          <input id="code" name="code" required autocomplete="off" autocapitalize="characters" value={joinError?.code ?? ""} />
        </div>
        <div class="field">
          <label for="memberName">Your name</label>
          <input id="memberName" name="memberName" required maxlength="60" autocomplete="name" value={joinError?.memberName ?? ""} />
        </div>
        <button type="submit">Join</button>
      </form>
    )
  }
</Base>
