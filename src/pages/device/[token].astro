---
import Base from "../../layouts/Base.astro";
import { db } from "../../lib/db.ts";
import { previewDeviceLink } from "../../lib/households.ts";

// Opening this link only shows who you'd be: chat apps and browsers prefetch
// links, which would burn a single-use token. The button below redeems it.
Astro.response.headers.set("Cache-Control", "no-store");

const { session } = Astro.locals;
const token = Astro.params.token ?? "";
const member = previewDeviceLink(db, token);
if (!member) Astro.response.status = 404;
---

{
  !member ? (
    <Base title="Device link not found">
      <h1>That device link doesn't work</h1>
      <p>Device links last 10 minutes and work once. Make a new one from the household page on your other device.</p>
    </Base>
  ) : session ? (
    <Base title="Already signed in">
      <h1>You're already signed in as {session.member.name}</h1>
      <p>This device already belongs to {session.household.name}, so this link hasn't changed anything.</p>
    </Base>
  ) : (
    <Base title="Sign in on this device">
      <h1>Sign in as {member.name} on this device</h1>
      <form class="stack" method="post" action={`/device/${token}/accept`}>
        <p>This adds this device to the household. The link stops working once you do.</p>
        <button type="submit">Sign in as {member.name}</button>
      </form>
    </Base>
  )
}
