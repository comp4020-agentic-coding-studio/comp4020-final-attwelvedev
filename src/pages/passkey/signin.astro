---
import Base from "../../layouts/Base.astro";

// Nothing here knows who is signing in: the browser offers the passkeys it
// holds, and the server learns who from the one that answers.
if (Astro.locals.session) return Astro.redirect("/", 303);
---

<Base title="Sign in with a passkey">
  <h1>Sign in with a passkey</h1>
  <p>Choose the passkey saved on this device. It signs you in as the same person, with no name to type.</p>
  <noscript><p>Passkeys need scripts. You can still join with an invite link or a code from <a href="/join">the Join page</a>.</p></noscript>
  <p>
    <button type="button" id="passkey-signin" hidden>Sign in with a passkey</button>
  </p>
  <p id="passkey-unsupported" hidden>This browser can't use passkeys.</p>
  <p id="passkey-status" role="status"></p>
  <p><a href="/">Back to the start</a></p>
</Base>

<script>
  import { browserSupportsWebAuthn, startAuthentication } from "@simplewebauthn/browser";

  const button = document.getElementById("passkey-signin") as HTMLButtonElement;
  const unsupported = document.getElementById("passkey-unsupported") as HTMLElement;
  const status = document.getElementById("passkey-status") as HTMLElement;

  if (browserSupportsWebAuthn()) {
    button.hidden = false;
    button.addEventListener("click", async () => {
      status.textContent = "";
      button.disabled = true;
      try {
        const options = await fetch("/passkey/signin/options", { method: "POST" });
        if (!options.ok) throw new Error("options");
        const response = await startAuthentication({ optionsJSON: await options.json() });
        const verified = await fetch("/passkey/signin/verify", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(response),
        });
        if (!verified.ok) throw new Error("verify");
        location.assign("/");
      } catch {
        status.textContent = "That passkey didn't work. Try again, or join with an invite link or code.";
        button.disabled = false;
      }
    });
  } else {
    unsupported.hidden = false;
  }
</script>
