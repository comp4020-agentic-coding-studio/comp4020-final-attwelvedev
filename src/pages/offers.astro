---
import { OffersFeed } from "../components/OffersFeed.tsx";
import Base from "../layouts/Base.astro";
import { db } from "../lib/db.ts";
import { offersSnapshotFor } from "../lib/offers.ts";

const { session } = Astro.locals;
if (!session) return Astro.redirect("/", 303);
const snapshot = offersSnapshotFor(db, session);
---

<Base title="Offers">
  <h1>Offers</h1>
  <OffersFeed client:load initial={snapshot} />
</Base>
