---
import CopyLink from "../../components/CopyLink.astro";
import { MemberList } from "../../components/MemberList.tsx";
import Base from "../../layouts/Base.astro";
import { db } from "../../lib/db.ts";
import { listMembers } from "../../lib/households.ts";
import { offeringFor } from "../../lib/offers.ts";

const { session, newInviteLink } = Astro.locals;
if (!session) return Astro.redirect("/", 303);

// A freshly minted link is on the page: never cache it.
if (newInviteLink) Astro.response.headers.set("Cache-Control", "no-store");

const members = listMembers(db, session.household.id);
const pickupNote = offeringFor(db, session).defaultPickupNote ?? "";
const onlyMe = members.length === 1;
const inviteUrl = newInviteLink ? new URL(`/join/${newInviteLink.token}`, Astro.url).href : "";
---

<Base title={`${session.household.name} household`}>
  <h1>{session.household.name}</h1>

  <section class="stack" aria-labelledby="members-heading">
    <h2 id="members-heading">Members</h2>
    <MemberList client:load initial={members.map((m) => ({ id: m.id, name: m.name }))} meId={session.member.id} />
  </section>

  <section class="stack" aria-labelledby="invite-heading">
    <h2 id="invite-heading">Invite someone</h2>
    <p>
      Invite code: <strong id="invite-code" class="code">{session.household.inviteCode}</strong>
    </p>
    <p class="muted">Anyone with the code can join, from the Join page.</p>
    {
      newInviteLink ? (
        <div class="notice stack">
          <CopyLink id="invite-link" label="Invite link" value={inviteUrl} />
          <p class="muted">This link works for 7 days. It is shown once, so copy it now.</p>
        </div>
      ) : null
    }
    <form method="post" action="/household/invite-link">
      <button type="submit">Create an invite link</button>
    </form>
  </section>

  <section class="stack" aria-labelledby="devices-heading">
    <h2 id="devices-heading">Your devices</h2>
    <p><a href="/household/devices">Add another device</a> (a phone, say) by link or QR code.</p>
  </section>

  <section class="stack" aria-labelledby="pickup-heading">
    <h2 id="pickup-heading">Pickup note</h2>
    <p class="muted">Each offer has its own note, which you can write or change when you offer and later from the pantry. This is the last one you used, so the next offer starts from it. Only your household and the one that claims an offer see its note.</p>
    <form class="stack" method="post" action="/household/pickup-note">
      <div class="field">
        <label for="pickup-note">Last pickup note</label>
        <input id="pickup-note" name="note" required maxlength="280" autocomplete="off" value={pickupNote} />
      </div>
      <button type="submit">Save pickup note</button>
    </form>
  </section>

  <section class="stack" aria-labelledby="communities-heading">
    <h2 id="communities-heading">Communities</h2>
    <p><a href="/communities">Communities</a> are how households share food nearby. Start one or join one with a code.</p>
  </section>

  <section class="stack" aria-labelledby="leave-heading">
    <h2 id="leave-heading">Leave</h2>
    <p>
      {
        onlyMe
          ? "You're the last member: leaving deletes this household and its pantry."
          : "Leaving signs you out. The household and its pantry stay for the others."
      }
    </p>
    <form method="post" action="/household/leave">
      <button type="submit">Leave {session.household.name}</button>
    </form>
  </section>
</Base>
