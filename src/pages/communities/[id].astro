---
import { CommunityHouseholds } from "../../components/CommunityHouseholds.tsx";
import CopyLink from "../../components/CopyLink.astro";
import Base from "../../layouts/Base.astro";
import { getCommunity } from "../../lib/communities.ts";
import { db } from "../../lib/db.ts";
import { NotFoundError } from "../../lib/errors.ts";
import { json, wantsJson } from "../../lib/http.ts";

const { session, newCommunityLink } = Astro.locals;
if (!session) return Astro.redirect("/", 303);

// A freshly minted link is on the page: never cache it.
if (newCommunityLink) Astro.response.headers.set("Cache-Control", "no-store");

let view: ReturnType<typeof getCommunity> | null = null;
try {
  view = getCommunity(db, session.household.id, Astro.params.id ?? "");
} catch (error) {
  if (!(error instanceof NotFoundError)) throw error;
  Astro.response.status = 404;
}
// The live list refetches this on every stream open, so a reconnect catches up.
if (view && wantsJson(Astro.request.headers)) {
  return json({
    households: view.households.map((h) => ({
      householdId: h.householdId,
      displayName: h.displayName,
    })),
    creatorHouseholdId: view.community.creatorHouseholdId,
  });
}
const linkUrl = newCommunityLink
  ? new URL(`/communities/join/${newCommunityLink.token}`, Astro.url).href
  : "";
---

{
  !view ? (
    <Base title="Community not found">
      <h1>That community isn't one of yours</h1>
      <p>It may not exist, or {session.household.name} may have left it. <a href="/communities">See your communities</a>.</p>
    </Base>
  ) : (
    <Base title={view.community.name}>
      <h1>{view.community.name}</h1>

      <section class="stack" aria-labelledby="households-heading">
        <h2 id="households-heading">Households</h2>
        <CommunityHouseholds
          client:load
          communityId={view.community.id}
          myHouseholdId={session.household.id}
          initial={{
            households: view.households.map((h) => ({ householdId: h.householdId, displayName: h.displayName })),
            creatorHouseholdId: view.community.creatorHouseholdId,
          }}
        />
      </section>

      <section class="stack" aria-labelledby="invite-heading">
        <h2 id="invite-heading">Invite a household</h2>
        <p>
          Community code: <strong id="community-code" class="code">{view.community.joinCode}</strong>
        </p>
        <p class="muted">Anyone with a household can join with the code, from the Communities page.</p>
        {
          newCommunityLink ? (
            <div class="notice stack">
              <CopyLink id="community-link" label="Community link" value={linkUrl} />
              <p class="muted">This link works for 7 days. It is shown once, so copy it now.</p>
            </div>
          ) : null
        }
        <form method="post" action={`/communities/${view.community.id}/join-link`}>
          <button type="submit">Create a community link</button>
        </form>
      </section>

      <section class="stack" aria-labelledby="leave-heading">
        <h2 id="leave-heading">Leave</h2>
        <p>Leaving takes {session.household.name} out of this community, and withdraws what it offered here.</p>
        <form method="post" action={`/communities/${view.community.id}/leave`}>
          <button type="submit">Leave {view.community.name}</button>
        </form>
      </section>
    </Base>
  )
}
