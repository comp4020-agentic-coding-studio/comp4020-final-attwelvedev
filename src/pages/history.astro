---
import Base from "../layouts/Base.astro";
import { db } from "../lib/db.ts";
import { listHistory, type Outcome } from "../lib/items.ts";

const { session } = Astro.locals;
if (!session) return Astro.redirect("/", 303);

const FILTERS: { label: string; outcome?: Outcome }[] = [
  { label: "All" },
  { label: "Used", outcome: "used" },
  { label: "Binned", outcome: "binned" },
];
const asked = Astro.url.searchParams.get("outcome");
const filter = FILTERS.find((f) => f.outcome === asked)?.outcome;
const entries = listHistory(db, session.household.id, filter);

// Server-rendered, so the viewer's time zone isn't known here: say which one this is.
const when = (at: number) =>
  `${new Date(at).toLocaleString("en-AU", { timeZone: "UTC", dateStyle: "medium", timeStyle: "short" })} UTC`;
---

<Base title="History">
  <h1>History</h1>

  <nav aria-label="Filter history">
    {
      FILTERS.map((f) => (
        <a href={f.outcome ? `/history?outcome=${f.outcome}` : "/history"} aria-current={f.outcome === filter ? "true" : undefined}>
          {f.label}
        </a>
      ))
    }
  </nav>

  {
    entries.length === 0 ? (
      <p>Nothing recorded yet. Used, binned and given items land here.</p>
    ) : (
      <ul class="history">
        {entries.map((entry) => (
          <li>
            <strong>{entry.itemName}</strong> {entry.outcome}
            {entry.memberName ? <> by {entry.memberName}</> : entry.memberId && <> by a former member</>}
            <br />
            <time datetime={new Date(entry.at).toISOString()}>{when(entry.at)}</time>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<style>
  nav {
    display: flex;
    gap: 16px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  nav a[aria-current="true"] {
    font-weight: 700;
    text-decoration: none;
  }
  .history {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .history li {
    border-bottom: 1px solid var(--line);
    padding: 8px 0;
  }
  time {
    color: var(--ink-muted);
  }
</style>
