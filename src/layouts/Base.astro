---
import fontUrl from "../assets/fonts/archivo-ascii.woff2?url";
import "../styles/pages.css";
import "../styles/shell.css";
import "../styles/tokens.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="band">
      <div class="band-inner">
        <a class="brand" href="/">
          <svg class="marks" width="44" height="14" viewBox="0 0 44 14" aria-hidden="true" focusable="false">
            <circle cx="7" cy="7" r="6" fill="var(--role-blind)" />
            <rect x="17" y="1" width="12" height="12" fill="var(--role-deaf)" />
            <polygon points="37,1 43,13 31,13" fill="var(--role-mute)" />
          </svg>
          Sensory heist
        </a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer>
      <p>Keyboard: Tab and Shift+Tab move, Enter and Space press.</p>
      <a href="/readme/">About</a>
    </footer>
  </body>
</html>
