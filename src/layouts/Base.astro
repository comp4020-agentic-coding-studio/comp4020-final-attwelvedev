---
import "../styles/pages.css";
import "../styles/tokens.css";

interface Props {
  title: string;
  // a desktop layout with room for the offers rail beside the pantry
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
const here = Astro.url.pathname;
const NAV = [
  { href: "/", label: "Pantry" },
  ...(Astro.locals.session ? [{ href: "/offers", label: "Offers" }] : []),
  { href: "/history", label: "History" },
  ...(Astro.locals.session ? [{ href: "/household", label: "Household" }] : []),
  { href: "/readme/", label: "About" },
];
// a section is current on its sub-pages too (/household/devices)
const current = (href: string) => (href === "/" ? here === href : here.startsWith(href));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <nav aria-label="Main" class={wide ? "wide" : undefined}>
        {NAV.map((l) => <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>{l.label}</a>)}
      </nav>
    </header>
    <main id="main" class={wide ? "wide" : undefined}>
      <slot />
    </main>
    <footer>
      <a href="/readme/">About</a>
    </footer>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: 16px;
    line-height: 1.5;
  }
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 16px;
    overflow-wrap: anywhere;
  }
  header nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 16px;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 16px;
  }
  header nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  header nav a[aria-current="page"] {
    font-weight: 700;
    text-decoration: none;
  }
  main.wide,
  main.wide + footer,
  header nav.wide {
    max-width: 1112px;
  }
  footer {
    max-width: 720px;
    margin: 0 auto;
    padding: 16px;
  }
  a {
    color: var(--rim);
  }
  :focus-visible {
    outline: 3px solid var(--rim);
    outline-offset: 2px;
  }
  .skip {
    position: absolute;
    left: -999px;
  }
  .skip:focus {
    left: 16px;
    top: 16px;
    background: var(--surface);
    padding: 8px;
    z-index: 1;
  }
</style>
