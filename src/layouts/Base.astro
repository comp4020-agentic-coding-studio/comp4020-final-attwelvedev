---
import fontUrl from "../assets/fonts/atkinson-hyperlegible-next-latin.woff2?url";
import "../styles/pages.css";
import "../styles/shell.css";
import "../styles/tokens.css";

interface Props {
  title: string;
  // a desktop layout with room for the offers rail beside the pantry
  wide?: boolean;
}

const { title, wide = false } = Astro.props;
const here = Astro.url.pathname;
const session = Astro.locals.session;
// About lives in the footer; the tabs are the places a household goes daily
const NAV = [
  { href: "/", label: "Pantry" },
  ...(session ? [{ href: "/offers", label: "Offers" }] : []),
  { href: "/history", label: "History" },
  ...(session ? [{ href: "/household", label: "Household" }] : []),
];
// a section is current on its sub-pages too (/household/devices)
const current = (href: string) => (href === "/" ? here === href : here.startsWith(href));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="band">
      <div class={wide ? "band-inner wide" : "band-inner"}>
        <p class="brand">{session ? session.household.name : "Shared pantry"}</p>
        <nav aria-label="Main" class="tabs">
          {NAV.map((l) => <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>{l.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" class={wide ? "wide" : undefined}>
      <slot />
    </main>
    <footer class={wide ? "wide" : undefined}>
      <p class="help">Keyboard: Tab and Shift+Tab move, Enter and Space press.</p>
      <a href="/readme/">About</a>
    </footer>
  </body>
</html>

<style is:global>
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font);
    font-size: var(--t-16);
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--s-4);
    overflow-wrap: anywhere;
  }
  main.wide {
    max-width: 1112px;
  }
  a {
    color: var(--rim);
  }
</style>
