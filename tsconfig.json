{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "*.ts", "src", "spec", "scripts"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    // what Node type stripping can run: no enums, namespaces or parameter properties
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
