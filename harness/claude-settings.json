{
  "permissions": {
    "allow": [
      "Bash(pnpm check *)",
      "Bash(pnpm check)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm test *)",
      "Bash(pnpm test)",
      "Bash(pnpm exec biome *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(mise exec -- flyctl status *)",
      "Bash(mise exec -- flyctl logs *)",
      "Bash(mise exec -- flyctl releases *)",
      "Bash(mise exec -- flyctl apps list)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(mise exec -- flyctl deploy *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)",
      "Bash(mise exec -- flyctl apps destroy *)",
      "Bash(mise exec -- flyctl volumes destroy *)",
      "Bash(mise exec -- flyctl secrets *)",
      "Read(./mise.local.toml)",
      "Read(./.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/protect-fixed-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/guard-deploy.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/harness/hooks/format-on-edit.sh"
          }
        ]
      }
    ]
  }
}
